{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepGeo Metric Record",
  "type": "object",
  "required": ["metric_id", "name", "value", "unit", "input_artifacts", "recipe", "data_mode"],
  "properties": {
    "metric_id": {"type": "string"},
    "name": {"type": "string"},
    "value": {},
    "unit": {"type": "string"},
    "scope": {"type": "object"},
    "input_artifacts": {"type": "array", "minItems": 1},
    "recipe": {"type": "string"},
    "parameters": {"type": "object"},
    "data_mode": {"enum": ["simulated", "real", "mixed"]},
    "limitations": {"type": "array"}
  }
}
