{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepGeo Run Plan",
  "type": "object",
  "required": ["scenario", "enabled_nodes", "required_gates", "work_packages"],
  "properties": {
    "scenario": {"enum": ["xr_cinema", "scenic_park", "custom"]},
    "enabled_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_gates": {"type": "array", "items": {"enum": ["G1", "G2", "G3", "G4"]}, "uniqueItems": true},
    "network_authorized": {"type": "boolean"},
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_package_id", "node", "decision_questions", "recipes", "max_runtime_seconds"],
        "properties": {
          "work_package_id": {"type": "string"},
          "node": {"type": "string"},
          "decision_questions": {"type": "array", "minItems": 1, "maxItems": 4},
          "recipes": {"type": "array", "maxItems": 4},
          "publication_chart_limit": {"type": "integer", "maximum": 3},
          "max_runtime_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
