{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepGeo Domain Analysis Result",
  "type": "object",
  "required": ["artifact_id", "data_mode", "node", "analysis_runs", "findings", "publication_chart_candidates"],
  "properties": {
    "artifact_id": {"type": "string"},
    "data_mode": {"enum": ["simulated", "real", "mixed"]},
    "node": {"type": "string"},
    "analysis_runs": {"type": "array", "maxItems": 4},
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["finding_id", "statement", "evidence_level", "metric_ids", "limitations"],
        "properties": {
          "finding_id": {"type": "string"},
          "statement": {"type": "string"},
          "evidence_level": {"enum": ["observed", "association", "inference", "model_based_projection", "hypothesis", "trial_supported"]},
          "metric_ids": {"type": "array", "minItems": 1},
          "limitations": {"type": "array"}
        }
      }
    },
    "publication_chart_candidates": {"type": "array", "maxItems": 3},
    "warnings": {"type": "array"}
  }
}
