{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepGeo Claim Ledger",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "evidence_level", "allowed_expression", "supports"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string"},
          "evidence_level": {"enum": ["observed", "association", "inference", "model_based_projection", "hypothesis", "trial_supported"]},
          "allowed_expression": {"enum": ["fact", "supported_judgment", "limited_judgment", "hypothesis_only", "do_not_publish"]},
          "supports": {"type": "array", "minItems": 1},
          "limitations": {"type": "array"}
        }
      }
    }
  }
}
