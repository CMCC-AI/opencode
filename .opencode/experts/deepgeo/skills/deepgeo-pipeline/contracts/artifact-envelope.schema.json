{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepGeo Artifact Envelope",
  "type": "object",
  "required": ["artifact_id", "schema_version", "run_id", "producer", "data_mode", "created_at", "status"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "producer": {"type": "string"},
    "parent_artifacts": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "sha256"]}},
    "data_mode": {"enum": ["simulated", "real", "mixed"]},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "status": {"enum": ["valid", "degraded", "blocked", "failed"]}
  },
  "additionalProperties": true
}
