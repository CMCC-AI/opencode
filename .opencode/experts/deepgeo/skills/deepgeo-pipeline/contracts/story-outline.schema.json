{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepGeo Reader-first Story Outline",
  "type": "object",
  "required": ["title", "audience", "central_question", "opening_answer", "chapters"],
  "properties": {
    "title": {"type": "string", "minLength": 8},
    "audience": {"type": "string", "minLength": 4},
    "central_question": {"type": "string", "minLength": 10},
    "opening_answer": {"type": "string", "minLength": 30},
    "chapters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "reader_question", "key_message", "evidence_to_explain", "chart_ids", "plain_language_explanation", "transition_to_next"],
        "properties": {
          "chapter_id": {"type": "string"},
          "title": {"type": "string", "minLength": 4},
          "reader_question": {"type": "string", "minLength": 8},
          "key_message": {"type": "string", "minLength": 20},
          "evidence_to_explain": {"type": "array", "minItems": 1, "maxItems": 5},
          "chart_ids": {"type": "array", "maxItems": 2},
          "plain_language_explanation": {"type": "string", "minLength": 20},
          "transition_to_next": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
