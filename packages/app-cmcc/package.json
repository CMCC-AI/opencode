{
  "name": "@opencode-ai/app-cmcc",
  "version": "1.18.16",
  "description": "DeepInsight product extension for the standard OpenCode App",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.js",
    "./index.css": "./src/index.css"
  },
  "scripts": {
    "check:thin": "bun ./script/check-thin-shell.ts",
    "typecheck": "bun run check:thin && tsgo -b",
    "start": "vite",
    "dev": "vite",
    "build": "bun run check:thin && vite build",
    "serve": "vite preview",
    "test": "bun run check:thin && bun test ./src",
    "test:watch": "bun test --watch ./src"
  },
  "license": "MIT",
  "devDependencies": {
    "@sentry/vite-plugin": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@opencode-ai/session-ui": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@solidjs/router": "catalog:",
    "@tanstack/solid-query": "5.91.4",
    "docx-preview": "0.3.7",
    "pptx-preview": "1.0.7",
    "solid-js": "catalog:",
    "vis-network": "9.1.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
