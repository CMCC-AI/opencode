{
  "$schema": "https://opencode.ai/config.json",
  "model": "moonshotai-cn/kimi-k3",
  "disabled_providers": [
    "alibaba",
    "zai",
    "zhipuai-coding-plan",
    "zai-coding-plan",
    "moonshotai",
    "kimi-code-plan-cn",
    "kimi-code-plan-global",
    "kimi-for-coding",
  ],
  "provider": {
    "jiutian-cmcc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CMCC",
      "env": ["CMCC_API_KEY"],
      "options": {
        "baseURL": "http://8.130.156.14:8000/jt236b/v1"
      },
      "models": {
        "jt236b": {
          "name": "Jiutian-236B",
          "reasoning": true,
          "tool_call": true
        }
      }
    },
    "moonshotai-cn": {
      "whitelist": ["kimi-k3"]
    }
  }
}