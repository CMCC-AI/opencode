# Copy to .deploy/quota.env, or set OPENCODE_QUOTA_ENV_FILE to a private Bash env file.
# The secret must match DockAPI. Generate it once with: openssl rand -hex 32
# Do not commit the real secret. An empty value deliberately blocks deployment.
OPENCODE_DOCKAPI_QUOTA_ENABLED=true
# This URL is for same-host deployment, not the public Nginx :3002 endpoint.
OPENCODE_DOCKAPI_URL=http://127.0.0.1:8081
DOCKAPI_QUOTA_SERVICE_TOKEN=
